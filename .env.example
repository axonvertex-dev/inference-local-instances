# Copy this file to .env and edit only the values required by your host.
# Never commit the real .env file.

# Optional Hugging Face access token. Required only for gated/private models.
HF_TOKEN=

# -----------------------------
# vLLM: Docker + NVIDIA GPU
# -----------------------------
VLLM_IMAGE=vllm/vllm-openai:latest
# Small-instance default: official Gemma 4 E2B QAT W4A16 checkpoint for vLLM.
VLLM_MODEL=google/gemma-4-E2B-it-qat-w4a16-ct
# Full BF16 alternative. Official recipe recommends a 24 GB+ GPU:
# VLLM_MODEL=google/gemma-4-E2B-it
VLLM_PORT=18181
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=2
VLLM_TENSOR_PARALLEL_SIZE=1

# -----------------------------
# LiteRT-LM: Docker + CPU
# -----------------------------
LITERT_LM_VERSION=0.13.1
LITERT_HF_REPO=litert-community/gemma-4-E2B-it-litert-lm
LITERT_MODEL_FILE=gemma-4-E2B-it.litertlm
LITERT_MODEL_ID=gemma4-e2b
LITERT_PORT=18182

# -----------------------------
# Ollama: Docker + NVIDIA GPU
# -----------------------------
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODEL=gemma4:e2b
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1

# -----------------------------
# Apple Silicon: native MLX
# -----------------------------
MLX_MODEL=mlx-community/gemma-4-e2b-it-4bit
MLX_HOST=127.0.0.1
MLX_PORT=18183
MLX_LM_VERSION=0.31.2
MLX_VLM_VERSION=0.4.5
